# Copy this file to .env and fill in your own values. Never commit .env.

# Secret the Shortcut sends as "Authorization: Bearer <token>". At least 16 characters.
SAYITSHIP_TOKEN=change-me-to-a-long-random-string

# ntfy topic you subscribed to in the ntfy app. Long and random: on ntfy.sh the topic name is the password.
NTFY_TOPIC=change-me
NTFY_SERVER=https://ntfy.sh

# Listen address. Use your PC's Tailscale IP (tailscale ip -4) so only your tailnet can reach it.
HOST=127.0.0.1
PORT=8787
# How the phone reaches the server (approval buttons use it). Default: http://HOST:PORT
# PUBLIC_URL=http://100.x.y.z:8787

# Projects the router can pick from. Copy projects.example.json to projects.json.
# PROJECTS_FILE=projects.json

# Router. GEMINI_API_KEY can also live in your user environment variables.
# Models are tried in order; if all fail, the request runs as a task in the default project.
# GEMINI_API_KEY=
# ROUTER_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest

# Seconds before a task is stopped, and before an unanswered approval counts as "No".
TASK_TIMEOUT=1800
APPROVAL_TIMEOUT=300

# Extra flags for `claude -p`. Bash is allowed, but every non read-only command asks your phone first.
# CLAUDE_ARGS=--permission-mode acceptEdits --allowedTools Read Edit Write Glob Grep WebSearch WebFetch Bash
