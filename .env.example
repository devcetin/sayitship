# Copy this file to .env and fill in your own values. Never commit .env.

# Secret the Shortcut sends as "Authorization: Bearer <token>". At least 16 characters.
SAYITSHIP_TOKEN=change-me-to-a-long-random-string

# ntfy topic you subscribed to in the ntfy app. Long and random: on ntfy.sh the topic name is the password.
NTFY_TOPIC=sayitship-change-me
NTFY_SERVER=https://ntfy.sh

# Folders Claude Code may work in, as name=path separated by ";". The first one is the default.
WORKDIRS=sandbox=C:/code/sayitship-sandbox

# Listen address. Use your PC's Tailscale IP (tailscale ip -4) so only your tailnet can reach it.
HOST=127.0.0.1
PORT=8787

# Seconds before a task is stopped.
TASK_TIMEOUT=1800

# Extra flags for `claude -p`. Default: may read and edit files in the workdir, no shell commands.
# CLAUDE_ARGS=--permission-mode acceptEdits --allowedTools Read Edit Write Glob Grep
